# npm run setup generates private secrets and a matching database password.
APP_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://folio:replace-database-password@127.0.0.1:55432/folio
POSTGRES_PASSWORD=replace-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
COMPILER_URL=http://127.0.0.1:4100
COMPILER_TOKEN=replace-with-at-least-24-random-characters
COMPILER_IMAGE=folio-tex:local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Folio <noreply@folio.local>"
# Production SMTP, when needed:
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# Production requires HTTPS. Compose explicitly allows its loopback HTTP URL.

# Optional paid plans: configure all three together. Never expose these to clients.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TEAM_PRICE_ID=price_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
