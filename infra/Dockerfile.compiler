FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends latexmk texlive-latex-base texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended && rm -rf /var/lib/apt/lists/*
ENV openin_any=p openout_any=p
WORKDIR /work
USER 65534:65534
ENTRYPOINT ["latexmk", "-norc", "-pdf", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-no-shell-escape", "-outdir=/work/output"]
