{
  "name": "folio-latex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview",
    "docs:test": "npm --prefix docs-site test",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "npm run lint:eslint && npm run lint:anti-slop",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "compiler": "node --env-file=.env.local --import tsx services/compiler/server.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:compiler": "node --import tsx --test tests/compiler.integration.ts",
    "test:browser": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:migrate:container": "node --import tsx scripts/migrate.ts",
    "test:saas": "node --env-file=.env.local --import tsx --test tests/saas.integration.ts",
    "billing:reconcile": "node --env-file=.env.local --import tsx scripts/reconcile-billing.ts",
    "test:billing": "node --env-file=.env.local --import tsx --test tests/billing.integration.ts",
    "billing:reconcile:container": "node --import tsx scripts/reconcile-billing.ts",
    "billing:listen": "node --env-file=.env.local scripts/stripe-listen.mjs",
    "billing:check": "node --env-file=.env.local --import tsx scripts/check-billing.ts",
    "test:stripe": "node --env-file=.env.local --import tsx --test tests/billing.stripe.ts tests/billing-clock.stripe.ts",
    "lint:eslint": "eslint .",
    "lint:anti-slop": "NODE_OPTIONS='--import tsx' oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"services/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"services/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "test:db": "node --env-file=.env.local --import tsx --test tests/database.integration.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.6",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "5.5.207",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
