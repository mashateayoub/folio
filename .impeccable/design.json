  "narrative": {
    "northStar": "The Document Workbench",
    "overview": "Folio gives writing a quiet, precise home. Warm paper surfaces, graphite text, and muted vermilion place the source and its typeset result at the center. The application uses self-hosted Satoshi; source uses monospace, while document output retains its own typography.\n\nControls are compact and legible. Rules and tonal changes organize everyday work; soft shadows identify floating dialogs and paper previews. The authentication specimen expresses the source-to-document relationship on a graphite field, with motion limited to its entrance.",
    "keyCharacteristics": [
      "Warm paper, graphite text, and one vermilion action accent.",
      "Self-hosted Satoshi with monospace source and independent document typography.",
      "Flat task surfaces, contained editing panes, and soft elevation for paper and dialogs.",
      "Regular Phosphor icons, visible focus, and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use vermilion for actions, focus, and meaningful document state; preserve neutral surfaces for reading and editing.",
        "section": "colors"
      },
      {
        "name": "The Document Type Rule",
        "body": "Keep application hierarchy in Satoshi and source in monospace; preserve the typography chosen by each compiled document.",
        "section": "typography"
      },
      {
        "name": "The Contained Workbench Rule",
        "body": "Keep source and PDF scrolling inside their panes and reserve the viewport for the editing task.",
        "section": "layout"
      },
      {
        "name": "The Paper Lift Rule",
        "body": "Reserve substantial elevation for document paper and floating dialogs; use rules and tone for ordinary navigation and content sections.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep reading and editing surfaces neutral and reserve vermilion for actions, focus, and document state.",
      "Do use self-hosted Satoshi, regular Phosphor SVG icons, and the established source monospace stack.",
      "Do contain source/PDF scroll areas and switch them through mobile tabs.",
      "Do preserve labeled fields, visible keyboard focus, semantic feedback, and reduced-motion behavior.",
      "Do show actual project metadata and meaningful saved/build states."
    ],
    "donts": [
      "Don't reintroduce the former pale-green and serif application identity.",
      "Don't use typeset document fonts for the application display hierarchy.",
      "Don't add perpetual decorative motion to editing panes or project lists.",
      "Don't invent activity, collaborators, performance metrics, or customer proof."
    ]
  }
}
